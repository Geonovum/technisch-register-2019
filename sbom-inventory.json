        { "url": "https://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/fonts/fontawesome-webfont.ttf?v=4.2.0", "name": "fonts/fontawesome-webfont.ttf" },
        { "url": "https://maxcdn.bootstrapcdn.com/font-awesome/4.2.0/fonts/fontawesome-webfont.woff?v=4.2.0", "name": "fonts/fontawesome-webfont.woff" }
      ],
      "bundled": false,
      "used": true,
      "usage": "loaded at runtime from a CDN by src/index.php; the CSS loads the font files"
